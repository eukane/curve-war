{
  "name": "curve-war",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:static": "tsx tools/audit/static.ts",
    "audit": "tsx tools/audit/sensitivity.ts .audit-work 4 && tsx tools/audit/analyze.ts .audit-work"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
